{
  "opencollection": "1.0.0",
  "info": {
    "name": "IPFS RPC Add Id API",
    "version": "v0"
  },
  "items": [
    {
      "info": {
        "name": "Id",
        "type": "folder"
      },
      "items": [
        {
          "info": {
