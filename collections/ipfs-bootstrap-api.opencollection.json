        },
        {
          "info": {
            "name": "bootstrap/rm",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "http://localhost:5001/api/v0/bootstrap/rm",
            "params": [
              {
                "name": "arg",
                "value": "",
                "type": "query",
                "description": "A peer to add to the bootstrap list (in the format '<multiaddr>/<peerID>')"
              },
              {
                "name": "all",
                "value": "",
                "type": "query",
                "description": "Remove all bootstrap peers. (Deprecated, use 'all' subcommand)."
              }
            ]
          },
          "docs": "Remove peers from the bootstrap list."
        },
        {
          "info": {
            "name": "bootstrap/rm/all",
            "type": "http"
